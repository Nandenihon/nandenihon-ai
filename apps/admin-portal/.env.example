# MySQL Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# --- Local / Development (SSH Tunnel) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name

# SSH Tunnel Configuration (only needed for remote MySQL in local dev)
SSH_HOST=your.server.ip.or.hostname
SSH_PORT=22
SSH_USERNAME=your_ssh_username
SSH_PASSWORD=your_ssh_password
# Alternatively, use a private key instead of a password:
# SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----

# JWT Secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Default admin password used when seeding the first admin user into an empty DB.
# Change this immediately after first login.
ADMIN_DEFAULT_PASSWORD=change-me-to-a-secure-password

# --- Upload Storage (Cloudflare R2) ---
# Endpoint may be account-level or bucket-level. Bucket-level default target:
R2_ENDPOINT=https://47442afd5a8cb46b3fa8ff4781a1188d.r2.cloudflarestorage.com/nande-nihon
R2_BUCKET=nande-nihon
R2_PUBLIC_BASE_URL=https://pub-3100e4c32b054e6598de798c71120dc1.r2.dev
# Development uploads go to bucket folder nande-nihon/dev/.
# For production, set R2_UPLOAD_PREFIX=prod so uploads go to nande-nihon/prod/.
R2_UPLOAD_PREFIX=dev
# Use Cloudflare R2 API Tokens > Access Key ID and Secret Access Key.
# R2_ACCESS_KEY_ID is 32 characters; do not use the public URL or Cloudflare API token here.
R2_ACCESS_KEY_ID=9df9753d8219c8ffdf26ad9fab9c2bd6
R2_SECRET_ACCESS_KEY=00273f976809d8c749ea9441e9bbd2696436108c2cea1992508a9d4579a109d3
# Optional max upload size in bytes. Default: 20971520 (20MB)
# UPLOAD_MAX_FILE_SIZE=20971520
# TOKEN Value = cfat_J3OQUB5OlbzkWpqAIIWW08gsOvG36ptqhmPrtS2i1bb7cbfd

# --- Vercel / Production ---
# Set these in the Vercel dashboard under Environment Variables.
# DB_HOST=your.production.db.host
# DB_PORT=3306
# DB_USER=your_production_db_user
# DB_PASSWORD=your_production_db_password
# DB_NAME=your_production_db_name
